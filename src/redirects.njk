---
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "{{ r.from }}"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pagina s-a mutat — Primii pași spre Linux</title>
  <meta name="description" content="Articolul s-a mutat pe o adresă nouă. Vei fi redirecționat automat.">
  <meta name="robots" content="noindex">
  <link rel="canonical" href="{{ r.to }}">
  <meta http-equiv="refresh" content="0; url={{ r.to }}">
  <style>
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 2rem;
           background: #FFFDF8; color: #1A1614;
           font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; }
    main { text-align: center; max-width: 34rem; }
    .eyebrow { margin: 0 0 .75rem; font-size: .8rem; letter-spacing: .12em;
               text-transform: uppercase; color: #E1552B; }
    h1 { margin: 0 0 1.5rem; font-size: 1.35rem; font-weight: 600; }
    a { color: #E1552B; font-weight: 600; }
  </style>
</head>
<body>
  <main>
    <p class="eyebrow">Primii pași spre Linux</p>
    <h1>Pagina s-a mutat pe adresa nouă.</h1>
    <p><a href="{{ r.to }}">{{ r.to }}</a></p>
    <script>location.replace("{{ r.to }}");</script>
  </main>
</body>
</html>
