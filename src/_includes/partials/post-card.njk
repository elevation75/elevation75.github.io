{% from "macros/icons.njk" import icon %}

{#-
  Post card.
    post     – a collection item
    variant  – "default" | "featured" | "compact"
-#}
{% macro postCard(post, variant = "default") %}
{%- set d = post.data -%}
{%- set accent = d.categoryMeta.accent if d.categoryMeta else "mint" -%}
{%- set catSlug = d.categoryMeta.slug if d.categoryMeta else "initiere" -%}
<article class="card card-post card-post--{{ variant }}">
  <a class="card-media" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
    <picture>
      {%- if d.cover.webp %}<source srcset="{{ d.cover.webp | assetv }}" type="image/webp">{% endif -%}
      <img src="{{ d.cover.jpg | assetv }}" alt="" loading="lazy" decoding="async">
    </picture>
    {%- if variant == "featured" %}
    <span class="card-media-badge">{{ icon("spark", "icon-sm") }} Recomandat pentru început</span>
    {%- endif %}
  </a>

  <div class="card-body">
    <div class="card-meta">
      <a class="chip chip--{{ accent }}" href="/categorii/{{ catSlug }}/">{{ d.categoryMeta.name if d.categoryMeta else d.category }}</a>
      <span class="card-meta-dot" aria-hidden="true"></span>
      <time datetime="{{ post.date | isoDate }}">{{ post.date | date }}</time>
      {%- if d.readingMinutes %}
      <span class="card-meta-dot" aria-hidden="true"></span>
      <span class="card-meta-time">{{ icon("clock", "icon-xs") }} {{ d.readingMinutes }} min</span>
      {%- endif %}
    </div>

    <h3 class="card-title">
      <a href="{{ post.url }}">{{ d.title }}</a>
    </h3>

    <p class="card-excerpt">{{ d.description }}</p>

    <span class="card-link" aria-hidden="true">
      Citește articolul {{ icon("arrow-right", "icon-sm") }}
    </span>
  </div>
</article>
{% endmacro %}
