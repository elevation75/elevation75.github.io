---
layout: layouts/base.njk
bodyClass: page-post
---
{%- from "macros/icons.njk" import icon -%}
{%- from "partials/post-card.njk" import postCard -%}
{%- set accent = categoryMeta.accent if categoryMeta else "mint" -%}
{%- set catSlug = categoryMeta.slug if categoryMeta else "initiere" -%}
{%- set tocItems = content | toc -%}
{%- set navPosts = collections.posts | surrounding(page.url) -%}
{%- set relatedPosts = collections.posts | related(page.url, category, 3) -%}

<article class="post">

  <header class="post-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fir de navigare">
        <a href="/">Acasă</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a href="/blog/">Postări</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span class="breadcrumb-current" aria-current="page">{{ title }}</span>
      </nav>

      <a class="chip chip--{{ accent }} chip--lg" href="/categorii/{{ catSlug }}/">{{ categoryMeta.name if categoryMeta else category }}</a>

      <h1 class="post-title">{{ title }}</h1>

      <p class="post-lead">{{ description }}</p>

      <div class="post-meta">
        <span class="post-meta-item">
          {{ icon("calendar", "icon-sm") }}
          <time datetime="{{ page.date | isoDate }}">{{ page.date | date }}</time>
        </span>
        <span class="post-meta-item">{{ icon("clock", "icon-sm") }} {{ content | readingMinutesLabel }} de citit</span>
        {%- if updated %}
        <span class="post-meta-item post-meta-item--muted">
          Actualizat {{ updated | date }}
        </span>
        {%- endif %}
      </div>
    </div>
  </header>

  {%- if cover %}
  <div class="container">
    <figure class="post-cover">
      <picture>
        {%- if cover.webp %}<source srcset="{{ cover.webp | assetv }}" type="image/webp">{% endif -%}
        <img src="{{ cover.jpg | assetv }}" alt="{{ cover.alt or title }}" decoding="async">
      </picture>
      {%- if cover.caption %}<figcaption>{{ cover.caption }}</figcaption>{% endif %}
    </figure>
  </div>
  {%- endif %}

  <div class="container post-layout{% if tocItems.length > 2 %} has-toc{% endif %}">

    {%- if tocItems.length > 2 %}
    <aside class="post-toc" aria-labelledby="toc-title">
      <p class="post-toc-title" id="toc-title">În acest articol</p>
      <ol class="post-toc-list">
        {%- for item in tocItems %}
        <li class="toc-item toc-item--l{{ item.level }}">
          <a href="#{{ item.id }}">{{ item.text }}</a>
        </li>
        {%- endfor %}
      </ol>
    </aside>
    {%- endif %}

    <div class="prose post-body">
      {{ content | safe }}
    </div>
  </div>

  <footer class="post-footer container">

    <div class="post-tags">
      <span class="post-tags-label">{{ icon("tag", "icon-sm") }} Categorie</span>
      <a class="chip chip--{{ accent }}" href="/categorii/{{ catSlug }}/">{{ categoryMeta.name if categoryMeta else category }}</a>
    </div>

    <div class="author-card">
      <img class="author-card-photo" src="{{ site.author.photo }}" alt="{{ site.author.name }}"
           width="88" height="88" loading="lazy" decoding="async">
      <div class="author-card-body">
        <p class="author-card-label">Scris de</p>
        <p class="author-card-name">{{ site.author.name }}</p>
        <p class="author-card-bio">{{ site.author.bio }}</p>
        <a class="text-link" href="/despre/">Mai multe despre mine {{ icon("arrow-right", "icon-sm") }}</a>
      </div>
    </div>

    {%- if navPosts.newer or navPosts.older %}
    <nav class="post-nav" aria-label="Navigare între articole">
      {%- if navPosts.older %}
      <a class="post-nav-item post-nav-item--older" href="{{ navPosts.older.url }}">
        <span class="post-nav-dir">{{ icon("arrow-left", "icon-sm") }} Articol anterior</span>
        <span class="post-nav-title">{{ navPosts.older.data.title }}</span>
      </a>
      {%- else %}<span class="post-nav-item post-nav-item--empty"></span>{%- endif %}

      {%- if navPosts.newer %}
      <a class="post-nav-item post-nav-item--newer" href="{{ navPosts.newer.url }}">
        <span class="post-nav-dir">Articol mai nou {{ icon("arrow-right", "icon-sm") }}</span>
        <span class="post-nav-title">{{ navPosts.newer.data.title }}</span>
      </a>
      {%- endif %}
    </nav>
    {%- endif %}

  </footer>

  {%- if relatedPosts.length %}
  <section class="section section--tight" aria-labelledby="related-title">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title" id="related-title">Continuă lectura</h2>
        <a class="text-link" href="/blog/">Toate postările {{ icon("arrow-right", "icon-sm") }}</a>
      </div>
      <div class="card-grid card-grid--3">
        {%- for post in relatedPosts %}
          {{ postCard(post) }}
        {%- endfor %}
      </div>
    </div>
  </section>
  {%- endif %}

</article>
