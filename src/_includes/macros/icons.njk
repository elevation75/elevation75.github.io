{# Simple, hand-drawn stroke icons. All 24×24, inherit colour and size. #}

{% macro icon(name, class="icon") %}
<svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- if name == "arrow-right" -%}
    <path d="M4 12h15M13 6l6 6-6 6"/>
  {%- elif name == "arrow-left" -%}
    <path d="M20 12H5M11 6l-6 6 6 6"/>
  {%- elif name == "chevron-right" -%}
    <path d="M9 5l7 7-7 7"/>
  {%- elif name == "clock" -%}
    <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>
  {%- elif name == "calendar" -%}
    <rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/>
  {%- elif name == "menu" -%}
    <path d="M4 7h16M4 12h16M4 17h16"/>
  {%- elif name == "close" -%}
    <path d="M6 6l12 12M18 6L6 18"/>
  {%- elif name == "search" -%}
    <circle cx="11" cy="11" r="6.5"/><path d="M15.8 15.8L20.5 20.5"/>
  {%- elif name == "mail" -%}
    <rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3.5 7.5l7.4 5.2a2 2 0 0 0 2.2 0l7.4-5.2"/>
  {%- elif name == "terminal" -%}
    <rect x="2.5" y="4" width="19" height="16" rx="3"/><path d="M7 9.5l3 2.5-3 2.5M12.5 15h4.5"/>
  {%- elif name == "check" -%}
    <path d="M4.5 12.5l5 5 10-11"/>
  {%- elif name == "spark" -%}
    <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M18.5 16.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z"/>
  {%- elif name == "seedling" -%}
    <path d="M12 21v-7"/><path d="M12 14C12 10 9 7.5 5 7.5c0 4 3 6.5 7 6.5z"/><path d="M12 12.5c0-3.3 2.6-5.5 6-5.5 0 3.5-2.6 5.5-6 5.5z"/>
  {%- elif name == "download" -%}
    <path d="M12 3v11M7.5 10L12 14.5 16.5 10"/><path d="M4 17v1.5A2.5 2.5 0 0 0 6.5 21h11a2.5 2.5 0 0 0 2.5-2.5V17"/>
  {%- elif name == "sliders" -%}
    <path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2.2"/><circle cx="10" cy="17" r="2.2"/>
  {%- elif name == "palette" -%}
    <path d="M12 21a9 9 0 1 1 9-9c0 2.2-1.8 3.5-3.8 3.5H15a2 2 0 0 0-1.5 3.3c.4.5.1 1.2-.6 1.2z"/>
    <circle cx="8" cy="10" r="1.1" fill="currentColor" stroke="none"/><circle cx="12" cy="7.5" r="1.1" fill="currentColor" stroke="none"/><circle cx="16" cy="9.5" r="1.1" fill="currentColor" stroke="none"/>
  {%- elif name == "book" -%}
    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H19v3H6.5A2.5 2.5 0 0 1 4 20.5z"/>
  {%- elif name == "layers" -%}
    <path d="M12 3l8.5 4.5L12 12 3.5 7.5z"/><path d="M3.5 12.5L12 17l8.5-4.5"/><path d="M3.5 17L12 21.5 20.5 17"/>
  {%- elif name == "users" -%}
    <circle cx="9" cy="8" r="3.4"/><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/><path d="M16 5.2a3.4 3.4 0 0 1 0 6.6M17.5 14.8c2 .8 3.5 2.6 3.5 5.2"/>
  {%- elif name == "heart" -%}
    <path d="M12 20s-7.5-4.6-7.5-9.6A4.4 4.4 0 0 1 12 7.4a4.4 4.4 0 0 1 7.5 3C19.5 15.4 12 20 12 20z"/>
  {%- elif name == "shield" -%}
    <path d="M12 3l7.5 3v5.4c0 4.5-3 8.3-7.5 9.6-4.5-1.3-7.5-5.1-7.5-9.6V6z"/><path d="M9 12l2.2 2.2L15.5 10"/>
  {%- elif name == "zap" -%}
    <path d="M13 2.5L5 13.5h6l-1 8 8-11h-6z"/>
  {%- elif name == "infinity" -%}
    <path d="M7.5 9a3 3 0 1 0 0 6c2.5 0 3.5-6 6-6a3 3 0 1 1 0 6c-2.5 0-3.5-6-6-6z"/>
  {%- elif name == "tag" -%}
    <path d="M3.5 11.4V5.5A2 2 0 0 1 5.5 3.5h5.9a2 2 0 0 1 1.4.6l7.1 7.1a2 2 0 0 1 0 2.8l-5.9 5.9a2 2 0 0 1-2.8 0l-7.1-7.1a2 2 0 0 1-.6-1.4z"/><circle cx="8" cy="8" r="1.4" fill="currentColor" stroke="none"/>
  {%- elif name == "rss" -%}
    <circle cx="6" cy="18" r="1.8" fill="currentColor" stroke="none"/><path d="M4 11a9 9 0 0 1 9 9M4 5a15 15 0 0 1 15 15"/>
  {%- elif name == "quote" -%}
    <path d="M9.5 6.5C7 8 5.5 10.4 5.5 13.4c0 2.4 1.4 4.1 3.3 4.1 1.7 0 3-1.3 3-3s-1.3-3-3-3c-.4 0-.7 0-1 .2"/>
    <path d="M18.5 6.5C16 8 14.5 10.4 14.5 13.4c0 2.4 1.4 4.1 3.3 4.1 1.7 0 3-1.3 3-3s-1.3-3-3-3c-.4 0-.7 0-1 .2"/>
  {%- elif name == "info" -%}
    <circle cx="12" cy="12" r="9"/><path d="M12 11v5.5"/><circle cx="12" cy="7.9" r="1.05" fill="currentColor" stroke="none"/>
  {%- elif name == "warning" -%}
    <path d="M10.3 4.3 2.8 17.2A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.8L13.7 4.3a2 2 0 0 0-3.4 0z"/><path d="M12 9.5V14"/><circle cx="12" cy="17" r="1.05" fill="currentColor" stroke="none"/>
  {%- elif name == "search" -%}
    <circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>
  {%- elif name == "pen" -%}
    <path d="M4 20l1-4.2L15.6 5.2a2 2 0 0 1 2.8 0l1.4 1.4a2 2 0 0 1 0 2.8L9.2 20z"/><path d="M14.5 6.5l3 3"/>
  {%- elif name == "compass" -%}
    <circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>
  {%- elif name == "github" -%}
    <path d="M9 19c-4 1.2-4-2.2-6-2.7m12 5.2v-3.4c0-1 .1-1.4-.5-2 2.6-.3 5.3-1.3 5.3-5.8a4.5 4.5 0 0 0-1.2-3.1 4.2 4.2 0 0 0-.1-3.2s-1-.3-3.3 1.2a11.3 11.3 0 0 0-6 0C6.9 2.6 5.9 2.9 5.9 2.9a4.2 4.2 0 0 0-.1 3.2A4.5 4.5 0 0 0 4.5 9.2c0 4.5 2.7 5.5 5.3 5.8-.4.4-.5.9-.5 1.5v4.4"/>
  {%- endif -%}
</svg>
{% endmacro %}
